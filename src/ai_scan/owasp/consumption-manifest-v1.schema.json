{
  "$comment": "Structural preflight only. Runtime requires exact lexical integers (not 1.0), unique scenario_ref identities, sum of all numeric values <= 10000000000, ceiling total_tokens = input_tokens + output_tokens, strict duplicate/nonfinite JSON rejection and bounded stable-file checks. Observed token arithmetic inconsistencies are findings; references are inert.",
  "$id": "https://electricentropy.com/schemas/ai-scan-consumption-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context_ref": {
      "maxLength": 64,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+){1,15}(?![\\s\\S])",
      "type": "string"
    },
    "scenarios": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "ceilings": {
            "additionalProperties": false,
            "properties": {
              "duration_ms": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "input_tokens": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "output_tokens": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "peak_concurrency": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "queue_depth": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "request_bytes": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "requests": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "response_bytes": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "retries": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "tool_steps": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "total_tokens": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "duration_ms",
              "input_tokens",
              "output_tokens",
              "peak_concurrency",
              "queue_depth",
              "request_bytes",
              "requests",
              "response_bytes",
              "retries",
              "tool_steps",
              "total_tokens"
            ],
            "type": "object"
          },
          "controls": {
            "additionalProperties": false,
            "properties": {
              "backpressure": {
                "type": "boolean"
              },
              "cancellation_enforced": {
                "type": "boolean"
              },
              "circuit_breaker": {
                "type": "boolean"
              },
              "cleanup_enforced": {
                "type": "boolean"
              },
              "deadline_enforced": {
                "type": "boolean"
              },
              "fail_closed_on_exhaustion": {
                "type": "boolean"
              },
              "per_scope_limits": {
                "type": "boolean"
              }
            },
            "required": [
              "backpressure",
              "cancellation_enforced",
              "circuit_breaker",
              "cleanup_enforced",
              "deadline_enforced",
              "fail_closed_on_exhaustion",
              "per_scope_limits"
            ],
            "type": "object"
          },
          "events": {
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "work_after_cancellation": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "cancellation_observed": {
                      "const": true
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "work_after_exhaustion": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "exhaustion_observed": {
                      "const": true
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "cleanup_observed": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "anyOf": [
                    {
                      "properties": {
                        "cancellation_observed": {
                          "const": true
                        }
                      }
                    },
                    {
                      "properties": {
                        "exhaustion_observed": {
                          "const": true
                        }
                      }
                    }
                  ]
                }
              }
            ],
            "properties": {
              "cancellation_observed": {
                "type": "boolean"
              },
              "cleanup_observed": {
                "type": "boolean"
              },
              "exhaustion_observed": {
                "type": "boolean"
              },
              "work_after_cancellation": {
                "type": "boolean"
              },
              "work_after_exhaustion": {
                "type": "boolean"
              }
            },
            "required": [
              "cancellation_observed",
              "cleanup_observed",
              "exhaustion_observed",
              "work_after_cancellation",
              "work_after_exhaustion"
            ],
            "type": "object"
          },
          "observations": {
            "additionalProperties": false,
            "properties": {
              "duration_ms": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "input_tokens": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "output_tokens": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "peak_concurrency": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "queue_depth": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "request_bytes": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "requests": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "response_bytes": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "retries": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "tool_steps": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "total_tokens": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "duration_ms",
              "input_tokens",
              "output_tokens",
              "peak_concurrency",
              "queue_depth",
              "request_bytes",
              "requests",
              "response_bytes",
              "retries",
              "tool_steps",
              "total_tokens"
            ],
            "type": "object"
          },
          "scenario_ref": {
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+){1,15}(?![\\s\\S])",
            "type": "string"
          }
        },
        "required": [
          "ceilings",
          "controls",
          "events",
          "observations",
          "scenario_ref"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "ai-scan-consumption-manifest-v1"
    }
  },
  "required": [
    "context_ref",
    "scenarios",
    "schema_version"
  ],
  "type": "object"
}
