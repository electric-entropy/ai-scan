{
  "$id": "https://ai-scan/schemas/target-v1.schema.json",
  "title": "target-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "name", "adapter", "endpoints", "request", "response"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "target"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "adapter": {"type": "string", "minLength": 1, "maxLength": 100},
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048, "x-url": true}
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "prompt_marker"],
      "properties": {
        "method": {"type": "string", "enum": ["GET", "POST"]},
        "prompt_marker": {"type": "string", "minLength": 1, "maxLength": 16},
        "body_template": {"type": "string", "maxLength": 65536},
        "content_type": {"type": "string", "maxLength": 200},
        "header_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["header"],
            "properties": {
              "header": {"type": "string", "minLength": 1, "maxLength": 200},
              "env": {"type": "string", "minLength": 1, "maxLength": 200, "x-secret-scan": true},
              "fd": {"type": "integer", "minimum": 0, "maximum": 65535}
            }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extract"],
      "properties": {
        "extract": {"type": "string", "enum": ["json_path", "raw_body", "regex"]},
        "json_path": {"type": "string", "maxLength": 512},
        "regex": {"type": "string", "maxLength": 512},
        "success_status": {"type": "integer", "minimum": 100, "maximum": 599}
      }
    },
    "auth_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["header"],
        "properties": {
          "header": {"type": "string", "minLength": 1, "maxLength": 200},
          "env": {"type": "string", "minLength": 1, "maxLength": 200, "x-secret-scan": true},
          "fd": {"type": "integer", "minimum": 0, "maximum": 65535}
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"type": "string", "enum": ["stateless", "stateful"]},
        "session_header": {"type": "string", "maxLength": 200},
        "reset_between_cases": {"type": "boolean"}
      }
    },
    "test_identities": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    }
  }
}
