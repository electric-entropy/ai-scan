{
  "$id": "https://ai-scan/schemas/plan-v1.schema.json",
  "title": "plan-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "mode", "target_origin", "policy", "packs", "seed"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "plan"},
    "mode": {"type": "string", "enum": ["reliable", "kitchen-sink"]},
    "target_origin": {
      "type": "string", "minLength": 1, "maxLength": 2048, "x-origin": true
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "pack_trust", "include_experimental", "allow_adaptive_generation",
        "minimum_attack_trials", "minimum_successes", "minimum_control_trials",
        "promote_statuses", "requests_per_second", "max_physical_requests",
        "max_duration_seconds", "max_concurrency", "require_deterministic_confirmation"
      ],
      "properties": {
        "name": {"type": "string", "enum": ["reliable", "kitchen-sink"]},
        "pack_trust": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {"type": "string", "enum": ["builtin", "signed", "local_approved"]}
        },
        "include_experimental": {"type": "boolean"},
        "allow_adaptive_generation": {"type": "boolean"},
        "minimum_attack_trials": {"type": "integer", "minimum": 1, "maximum": 1000},
        "minimum_successes": {"type": "integer", "minimum": 1, "maximum": 1000},
        "minimum_control_trials": {"type": "integer", "minimum": 1, "maximum": 1000},
        "promote_statuses": {
          "type": "array", "maxItems": 7,
          "items": {
            "type": "string",
            "enum": ["confirmed", "likely", "suspected", "not_observed", "inconclusive", "blocked", "not_tested"]
          }
        },
        "requests_per_second": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
        "max_physical_requests": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 256},
        "require_deterministic_confirmation": {"const": true}
      }
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "digest"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 100},
          "version": {"type": "string", "minLength": 1, "maxLength": 100},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "seed": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "created_at": {"type": "string", "minLength": 20, "maxLength": 40, "x-datetime": true}
  }
}
