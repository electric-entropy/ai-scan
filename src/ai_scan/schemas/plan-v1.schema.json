{
  "$id": "https://ai-scan/schemas/plan-v1.schema.json",
  "title": "plan-v1",
  "description": "The canonical runtime execution plan — the exact artifact the runner runs. Structural shape only; authoritative validation is load_plan + verify_plan_integrity (strict parse, digest verification, and exact policy/registry/target/case/limit/trial-policy match). Plans are policy-derived and re-verifiable, never user-tightened documents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_version", "mode", "origin", "target", "adapter", "seed",
    "packs", "cases", "limits", "trial_policy", "digest"
  ],
  "properties": {
    "plan_version": {"const": 1},
    "mode": {"type": "string", "enum": ["reliable", "kitchen-sink"]},
    "origin": {"type": "string", "minLength": 1, "maxLength": 2048, "x-origin": true},
    "target": {"type": "string", "minLength": 1, "maxLength": 2048, "x-url": true},
    "adapter": {"type": "string", "minLength": 1, "maxLength": 100},
    "seed": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "packs": {"type": "array", "minItems": 1, "maxItems": 256},
    "cases": {"type": "array", "minItems": 1, "maxItems": 100000},
    "limits": {"type": "array", "minItems": 4, "maxItems": 4},
    "trial_policy": {"type": "array", "minItems": 3, "maxItems": 3},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
