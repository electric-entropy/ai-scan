{
  "$id": "https://ai-scan/schemas/receipt-v2.schema.json",
  "title": "receipt-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "receipt_id", "engagement_digest", "target_scopes",
    "capabilities", "budgets", "valid_from", "valid_until", "key_id", "signature"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "receipt"},
    "receipt_id": {"type": "string", "minLength": 8, "maxLength": 200},
    "engagement_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048, "x-origin": true}
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_physical_requests", "max_duration_seconds", "requests_per_second", "max_concurrency"],
      "properties": {
        "max_physical_requests": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "requests_per_second": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_cost_usd": {"type": "number", "minimum": 0, "maximum": 1000000}
      }
    },
    "valid_from": {"type": "string", "minLength": 20, "maxLength": 40, "x-datetime": true},
    "valid_until": {"type": "string", "minLength": 20, "maxLength": 40, "x-datetime": true},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 200, "x-secret-scan": true},
    "signature": {"type": "string", "minLength": 1, "maxLength": 4096}
  }
}
